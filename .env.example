# Supabase Production Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred public browser key (modern Supabase key format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy compatibility only; not required when the publishable key above is set
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preferred server-only secret key. NEVER prefix with NEXT_PUBLIC_ and NEVER commit the real value.
SUPABASE_SECRET_KEY=your-secret-key

# Optional legacy server key fallback; leave empty when SUPABASE_SECRET_KEY is used
SUPABASE_SERVICE_ROLE_KEY=

# Organizer Administration
ADMIN_EMAIL=abud@admin.fun

# Supabase Storage Bucket for Payment Screenshots (Private)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=payment-screenshots

# Site URL for metadata / OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
